set_global_assignment -name TOP_LEVEL_ENTITY AllMyMuxesOnDE23Lite
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 26.1.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "11:22:35  OCTOBER 18, 2026"
set_global_assignment -name FAMILY "Agilex 3"
set_global_assignment -name DEVICE A3CZ135BB18AE7S
set_global_assignment -name VHDL_FILE ../src/AllMyMuxesOnDE23Lite.vhd
set_global_assignment -name VHDL_FILE "../../unitMux/src/Mux-UsingIf-a.vhd"
set_global_assignment -name VHDL_FILE "../../unitMux/src/Mux-StructTheNand2-a.vhd"
set_global_assignment -name VHDL_FILE "../../unitMux/src/TheNand2-e.vhd"
set_global_assignment -name VHDL_FILE "../src/TbdMux-e.vhd"
set_global_assignment -name VHDL_FILE "../src/TbdMux-Struct-a.vhd"
set_global_assignment -name VHDL_FILE "../../unitMux/src/Mux-e.vhd"
set_global_assignment -name VHDL_FILE "../../unitMux/src/Mux-Minterms-a.vhd"
set_global_assignment -name VHDL_FILE "../../unitMux/src/Mux-PrimeImpl-a.vhd"
set_global_assignment -name VHDL_FILE "../../unitMux/src/Mux-NandOnly-a.vhd"
set_global_assignment -name VHDL_FILE "../../unitMux/src/Mux-StructNand2-a.vhd"
set_global_assignment -name VHDL_FILE "../../unitMux/src/Mux-UsingCase-a.vhd"
set_global_assignment -name VHDL_FILE "../../../grpGates/unitNandGate2/src/NandGate2-e.vhd"
set_global_assignment -name VHDL_FILE "../../../grpGates/unitNandGate2/src/NandGate2-Rtl-a.vhd"
set_global_assignment -name VHDL_FILE "../../../grpResetReleaseIP/unitResetReleaseIP/hdl/ResetReleaseIP-e.vhd"
set_global_assignment -name VHDL_FILE "../../../grpResetReleaseIP/unitResetReleaseIP/hdl/ResetReleaseIP-Rtl-a.vhd"
set_global_assignment -name IP_FILE ../../../grpResetReleaseIP/unitResetReleaseIP/quartus/reset_release_ip.ip
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name POWER_APPLY_THERMAL_MARGIN ADDITIONAL

#============================================================
# I/O Standards (Per Wildcard elegant für alle Pins auf 1.2V)
#============================================================
set_instance_assignment -name IO_STANDARD "1.2-V" -to *

#============================================================
# Drive Strength & Slew Rate für die LED-Ausgänge
#============================================================
set_instance_assignment -name CURRENT_STRENGTH_NEW "MINIMUM CURRENT" -to LEDR*
set_instance_assignment -name SLEW_RATE 0 -to LEDR*

#============================================================
# CLOCK
#============================================================
set_location_assignment PIN_K43 -to CLOCK0_50

#============================================================
# Pin Locations (Schalter SW und LEDs)
#============================================================
# SW(0) = iSel, SW(1) = iB, SW(2) = iA
set_location_assignment PIN_A37 -to SW[0]
set_location_assignment PIN_B37 -to SW[1]
set_location_assignment PIN_B26 -to SW[2]

# LEDR(0) = Minterms, LEDR(1) = PrimeImpl, LEDR(2) = NandOnly
# LEDR(3) = StructTheNand2, LEDR(4) = UsingCase, LEDR(5) = UsingIf
set_location_assignment PIN_B39 -to LEDR[0]
set_location_assignment PIN_B42 -to LEDR[1]
set_location_assignment PIN_K35 -to LEDR[2]
set_location_assignment PIN_F32 -to LEDR[3]
set_location_assignment PIN_A19 -to LEDR[4]
set_location_assignment PIN_B24 -to LEDR[5]
set_global_assignment -name LAST_QUARTUS_VERSION "26.1.1 Pro Edition"
set_instance_assignment -name PARTITION Mux_1 -to Tbd|Mux_0 -entity AllMyMuxesOnDE23Lite
set_instance_assignment -name PARTITION Mux -to Tbd|Mux_3 -entity AllMyMuxesOnDE23Lite
set_instance_assignment -name PARTITION_COLOUR 4288413523 -to Tbd|Mux_3 -entity AllMyMuxesOnDE23Lite
set_instance_assignment -name PARTITION_COLOUR 4294953886 -to Tbd|Mux_0 -entity AllMyMuxesOnDE23Lite
